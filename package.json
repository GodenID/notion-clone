{
  "name": "notion-clone",
  "version": "2.0.0",
  "private": true,
  "description": "A Notion-style workspace: block editor, databases, teamspaces, commands, comments — served by a Fastify + SQLite backend",
  "type": "module",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "node backend/server.js",
    "start": "node backend/server.js",
    "dev:static": "node frontend/server.mjs",
    "migrate": "node backend/migrate-cli.js",
    "check": "node scripts/check.mjs",
    "test": "node test/run.mjs",
    "test:unit": "node test/run.mjs --unit",
    "test:harness": "node test/harness-run.mjs",
    "test:harness:static": "node scripts/harness-static.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
